# ===== Test file =====
TEST_FILE=/opt/backup-test/data/testfile.img

# ===== Encryption =====
GPG_RECIPIENT=jakirhosen9395@gmail.com

# ===== Local hourly backups =====
HOURLY_DIR=/opt/backup-test/backups/hourly
HOURLY_RETENTION_COUNT=1      # keep last 48 hourly snapshots (~2 days)

# ===== S3 =====
S3_BUCKET=158909019231-snipe-it-backups
S3_PREFIX=server1-testfile

# ===== Remote server (Server 2) =====
REMOTE_USER=backupuser
REMOTE_HOST=172.31.15.244
REMOTE_PATH=/opt/backup-test/incoming
SSH_KEY=/home/ubuntu/.ssh/backup_key

# ===== Notifications — set one or both, leave blank to disable =====
DISCORD_WEBHOOK=
SLACK_WEBHOOK=



{

  "Version": "2012-10-17",

  "Statement": [

    {

      "Effect": "Allow",

      "Action": ["s3:PutObject", "s3:GetObject"],

      "Resource": "arn:aws:s3:::158909019231-snipe-it-backups/server1-testfile/*"

    },

    {

      "Effect": "Allow",

      "Action": "s3:ListBucket",

      "Resource": "arn:aws:s3:::158909019231-snipe-it-backups",

      "Condition": { "StringLike": { "s3:prefix": "server1-testfile/*" } }

    }

  ]

}