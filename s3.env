# ==========================================================
# s3.env — Configuration for backup-s3.sh
# Backs up to an S3 bucket.
# ==========================================================

# --- Database ---
DB_NAME=snipeit_db

# --- Snipe-IT source paths ---
STORAGE_DIR=/var/www/html/snipe-it

# --- Local staging directory ---
# Encrypted files are briefly staged here before upload, then removed.
LOCAL_STAGING_DIR=/var/backups/snipeit/s3-staging

# --- Encryption ---
PASSPHRASE_FILE=/root/.secrets/backup_passphrase.txt

# --- S3 details ---
# If running on an EC2 instance with an IAM role attached, you do not need
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — the role is used automatically.
# Otherwise, configure credentials via `aws configure` for the root user first.
S3_BUCKET=REPLACE_WITH_YOUR_BUCKET_NAME
S3_PREFIX=snipeit-backups
AWS_REGION=ap-southeast-1

# --- Retention ---
# Delete S3 objects older than this many DAYS.
# (S3 cleanup is day-granularity here; use an S3 Lifecycle Rule instead for
# large-scale/production use — see README Part 6.)
RETENTION_DAYS=30

# --- Schedule ---
# How often this script runs a backup cycle, in SECONDS.
BACKUP_INTERVAL_SECONDS=3600

# --- Logging ---
LOG_FILE=/var/log/snipeit_backup_s3.log
