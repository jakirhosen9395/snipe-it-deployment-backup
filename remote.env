# ==========================================================
# remote.env — Configuration for backup-remote.sh
# Backs up to a SEPARATE remote server over SSH/rsync.
# ==========================================================

# --- Database ---
DB_NAME=snipeit_db

# --- Snipe-IT source paths ---
STORAGE_DIR=/var/www/html/snipe-it

# --- Local staging directory ---
# Encrypted files are briefly staged here before transfer, then removed.
LOCAL_STAGING_DIR=/var/backups/snipeit/remote-staging

# --- Encryption ---
PASSPHRASE_FILE=/root/.secrets/backup_passphrase.txt

# --- Remote server details ---
REMOTE_USER=ubuntu
REMOTE_HOST=REPLACE_WITH_REMOTE_SERVER_IP
REMOTE_DIR=~/snipeit-backups
SSH_KEY=/root/.ssh/snipeit_backup_key

# --- Retention ---
# Delete remote backups older than this many minutes.
# 10080 = 7 days.
RETENTION_MINUTES=10080

# --- Schedule ---
# How often this script runs a backup cycle, in SECONDS.
BACKUP_INTERVAL_SECONDS=600

# --- Logging ---
LOG_FILE=/var/log/snipeit_backup_remote.log
