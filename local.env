# ==========================================================
# local.env — Configuration for backup-local.sh
# Backs up to a directory ON THIS SAME SERVER.
# ==========================================================

# --- Database ---
DB_NAME=snipeit_db

# --- Snipe-IT source paths ---
STORAGE_DIR=/var/www/html/snipe-it

# --- Where local backups are stored ---
LOCAL_BACKUP_DIR=/var/backups/snipeit/local

# --- Encryption ---
# Passphrase file used to symmetrically encrypt every backup (AES256).
# Must exist and be chmod 600, owned by root. See README Part 2.
PASSPHRASE_FILE=/root/.secrets/backup_passphrase.txt

# --- Retention ---
# Delete local backups older than this many minutes.
# 1440 = 1 day. Adjust based on available disk space.
RETENTION_MINUTES=1440

# --- Schedule ---
# How often this script runs a backup cycle, in SECONDS.
# Examples: 10 (every 10 sec), 600 (every 10 min), 3600 (every hour)
BACKUP_INTERVAL_SECONDS=3600

# --- Logging ---
LOG_FILE=/var/log/snipeit_backup_local.log
